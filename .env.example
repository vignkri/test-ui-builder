# Browsers cannot open raw MQTTS (aggregator.gridhub.dev:8883); they need MQTT over WebSocket.
# Leave VITE_MQTT_URL unset and the console shows "Not connected" (there is no simulator).
VITE_MQTT_URL=wss://aggregator.gridhub.dev:8884/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
VITE_MQTT_CUSTOMER=acme-flex
# 4 = MQTT 3.1.1 (default), 5 = MQTT 5
VITE_MQTT_PROTOCOL_VERSION=4
